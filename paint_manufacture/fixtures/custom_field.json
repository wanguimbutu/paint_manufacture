[
 {
  "name": "Work Order-pm_is_paint_order",
  "doctype": "Custom Field",
  "dt": "Work Order",
  "fieldname": "pm_is_paint_order",
  "fieldtype": "Check",
  "insert_after": "amended_from",
  "label": "This is a Paint Order",
  "description": "Enable Paint-specific production fields",
  "allow_on_submit": 1
 },
 {
  "name": "Work Order-pm_tab",
  "doctype": "Custom Field",
  "dt": "Work Order",
  "fieldname": "pm_tab",
  "fieldtype": "Tab Break",
  "insert_after": "connections_tab",
  "label": "Paint Production",
  "depends_on": "eval:doc.pm_is_paint_order"
 },
 {
  "name": "Work Order-pm_sec_base_result",
  "doctype": "Custom Field",
  "dt": "Work Order",
  "fieldname": "pm_sec_base_result",
  "fieldtype": "Section Break",
  "insert_after": "pm_tab",
  "label": "Base Production Result",
  "depends_on": "eval:doc.pm_is_paint_order"
 },
 {
  "name": "Work Order-pm_produced_base_qty",
  "doctype": "Custom Field",
  "dt": "Work Order",
  "fieldname": "pm_produced_base_qty",
  "fieldtype": "Float",
  "insert_after": "pm_sec_base_result",
  "label": "Produced Base Qty",
  "description": "Actual qty of base produced from this batch",
  "depends_on": "eval:doc.pm_is_paint_order",
  "allow_on_submit": 1
 },
 {
  "name": "Work Order-pm_base_batch_no",
  "doctype": "Custom Field",
  "dt": "Work Order",
  "fieldname": "pm_base_batch_no",
  "fieldtype": "Link",
  "insert_after": "pm_produced_base_qty",
  "label": "Base Batch No",
  "options": "Batch",
  "depends_on": "eval:doc.pm_is_paint_order",
  "allow_on_submit": 1
 },
 {
  "name": "Work Order-pm_col_base",
  "doctype": "Custom Field",
  "dt": "Work Order",
  "fieldname": "pm_col_base",
  "fieldtype": "Column Break",
  "insert_after": "pm_base_batch_no"
 },
 {
  "name": "Work Order-pm_total_base_used",
  "doctype": "Custom Field",
  "dt": "Work Order",
  "fieldname": "pm_total_base_used",
  "fieldtype": "Float",
  "insert_after": "pm_col_base",
  "label": "Total Base Used (L)",
  "read_only": 1,
  "allow_on_submit": 1,
  "depends_on": "eval:doc.pm_is_paint_order"
 },
 {
  "name": "Work Order-pm_remaining_base_qty",
  "doctype": "Custom Field",
  "dt": "Work Order",
  "fieldname": "pm_remaining_base_qty",
  "fieldtype": "Float",
  "insert_after": "pm_total_base_used",
  "label": "Remaining Base (L)",
  "read_only": 1,
  "allow_on_submit": 1,
  "description": "Produced Base Qty minus base used in packaging. Returned to stock.",
  "depends_on": "eval:doc.pm_is_paint_order"
 },
 {
  "name": "Work Order-pm_sec_additional",
  "doctype": "Custom Field",
  "dt": "Work Order",
  "fieldname": "pm_sec_additional",
  "fieldtype": "Section Break",
  "insert_after": "pm_remaining_base_qty",
  "label": "Additional Materials",
  "description": "Materials added to the base that are not in the BOM (e.g. pigments, tinters)",
  "depends_on": "eval:doc.pm_is_paint_order"
 },
 {
  "name": "Work Order-pm_additional_materials",
  "doctype": "Custom Field",
  "dt": "Work Order",
  "fieldname": "pm_additional_materials",
  "fieldtype": "Table",
  "insert_after": "pm_sec_additional",
  "label": "Additional Materials",
  "options": "PM Additional Material",
  "depends_on": "eval:doc.pm_is_paint_order",
  "allow_on_submit": 1
 },
 {
  "name": "Work Order-pm_sec_packaging",
  "doctype": "Custom Field",
  "dt": "Work Order",
  "fieldname": "pm_sec_packaging",
  "fieldtype": "Section Break",
  "insert_after": "pm_additional_materials",
  "label": "Packaging",
  "description": "Define how many units of each finished SKU are packed from this batch",
  "depends_on": "eval:doc.pm_is_paint_order"
 },
 {
  "name": "Work Order-pm_packaging_items",
  "doctype": "Custom Field",
  "dt": "Work Order",
  "fieldname": "pm_packaging_items",
  "fieldtype": "Table",
  "insert_after": "pm_sec_packaging",
  "label": "Packaging Items",
  "options": "PM Packaging Item",
  "depends_on": "eval:doc.pm_is_paint_order",
  "allow_on_submit": 1
 },
 {
  "name": "Work Order-pm_tab_quality",
  "doctype": "Custom Field",
  "dt": "Work Order",
  "fieldname": "pm_tab_quality",
  "fieldtype": "Tab Break",
  "insert_after": "pm_packaging_items",
  "label": "Paint Quality",
  "depends_on": "eval:doc.pm_is_paint_order"
 },
 {
  "name": "Work Order-pm_quality_inspection_template",
  "doctype": "Custom Field",
  "dt": "Work Order",
  "fieldname": "pm_quality_inspection_template",
  "fieldtype": "Link",
  "insert_after": "pm_tab_quality",
  "label": "Quality Inspection Template",
  "options": "Quality Inspection Template",
  "depends_on": "eval:doc.pm_is_paint_order",
  "allow_on_submit": 1
 },
 {
  "name": "Work Order-pm_quality_readings",
  "doctype": "Custom Field",
  "dt": "Work Order",
  "fieldname": "pm_quality_readings",
  "fieldtype": "Table",
  "insert_after": "pm_quality_inspection_template",
  "label": "Quality Readings",
  "options": "PM Quality Reading",
  "depends_on": "eval:doc.pm_is_paint_order",
  "allow_on_submit": 1
 },
 {
  "name": "Work Order-pm_quality_inspection",
  "doctype": "Custom Field",
  "dt": "Work Order",
  "fieldname": "pm_quality_inspection",
  "fieldtype": "Link",
  "insert_after": "pm_quality_readings",
  "label": "Quality Inspection",
  "options": "Quality Inspection",
  "read_only": 1,
  "depends_on": "eval:doc.pm_is_paint_order"
 },
 {
  "name": "Work Order-pm_base_stock_entry",
  "doctype": "Custom Field",
  "dt": "Work Order",
  "fieldname": "pm_base_stock_entry",
  "fieldtype": "Link",
  "insert_after": "pm_base_batch_no",
  "label": "Base Stock Entry",
  "options": "Stock Entry",
  "read_only": 1,
  "description": "Stage 1 stock entry: raw materials consumed, base paint received into WIP",
  "depends_on": "eval:doc.pm_is_paint_order"
 },
 {
  "name": "Work Order-pm_paint_stock_entry",
  "doctype": "Custom Field",
  "dt": "Work Order",
  "fieldname": "pm_paint_stock_entry",
  "fieldtype": "Link",
  "insert_after": "pm_quality_inspection",
  "label": "Paint Stock Entry",
  "options": "Stock Entry",
  "read_only": 1,
  "description": "Stage 2 stock entry: base consumed, finished SKUs received into FG",
  "depends_on": "eval:doc.pm_is_paint_order"
 },
 {
  "name": "Work Order-custom_work_order_batch",
  "doctype": "Custom Field",
  "dt": "Work Order",
  "fieldname": "custom_work_order_batch",
  "fieldtype": "Link",
  "insert_after": "batch_size",
  "label": "Work Order Batch",
  "options": "Batch",
  "description": "Required by batch_qr_code app",
  "allow_on_submit": 1
 },
 {
  "name": "Stock Entry-paint_production_order",
  "doctype": "Custom Field",
  "dt": "Stock Entry",
  "fieldname": "paint_production_order",
  "fieldtype": "Link",
  "insert_after": "work_order",
  "label": "Paint Production Order",
  "options": "Paint Production Order",
  "print_hide": 1,
  "read_only": 1
 }
]
